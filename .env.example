# Copy to .env.local and fill in

# Email (lead notifications + OTP codes) - free Gmail SMTP
# EMAIL_PASS must be a Gmail App Password (Google Account > Security > 2-Step Verification > App passwords),
# not your normal Gmail password. In development, if these are empty, OTP codes are printed to the server console.
EMAIL_USER=
EMAIL_PASS=

# MongoDB connection string
# Free hosted option: MongoDB Atlas M0 cluster (512 MB, free forever) - https://www.mongodb.com/cloud/atlas/register
#   MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ruby-estates?retryWrites=true&w=majority
# Local development:
MONGODB_URI=mongodb://127.0.0.1:27017/ruby-estates

# Long random string used to sign login tokens (required in production)
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# First admin account, created automatically on the first login if no admin exists
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Copy to .env.local and fill in

# Email (lead notifications)
EMAIL_USER=
EMAIL_PASS=

# MongoDB connection string
MONGODB_URI=mongodb://127.0.0.1:27017/ruby-estates

# Long random string used to sign login tokens (required in production)
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# First admin account, created automatically on the first login if no admin exists
ADMIN_EMAIL=
ADMIN_PASSWORD=
